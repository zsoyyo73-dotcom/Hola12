local function PlaySong(index, isFromHistory)
    if index < 1 or index > #playlist then return end
    
    local song = playlist[index]
    local ext = string.match(song.url, "%.([%a%d]+)$") or "ogg"
    local fileName = "utils music/" .. song.name .. "." .. ext
    
    StatusLabel.Text = "Descargando..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)

    task.spawn(function()
        local needsDownload = true
        if isfile(fileName) then
            local successRead, content = pcall(function() return readfile(fileName) end)
            if successRead and content and #content > 1024 then
                needsDownload = false
            end
        end

        if needsDownload then
            local success, res = pcall(function()
                return game:HttpGet(song.url)
            end)
            if success and res and #res > 1024 then
                pcall(function() writefile(fileName, res) end)
            end
        end

        if isfile(fileName) then
            if activeSound then
                activeSound:Stop()
                activeSound:Destroy()
            end
            if progressConn then
                progressConn:Disconnect()
            end

            local soundSuccess, customAssetUrl = pcall(function()
                return getcustomasset(fileName)
            end)

            if soundSuccess and customAssetUrl then
                local sound = Instance.new("Sound")
                sound.Name = "NexusPlayingTrack"
                sound.SoundId = customAssetUrl
                sound.Volume = 3
                sound.Parent = SoundService
                sound:Play()
                activeSound = sound

                if pauseAssetUrl ~= "" then
                    ToggleBtn.Image = pauseAssetUrl
                end

                CurrentTrackLabel.Text = song.name
                currentIndex = index

                if not isFromHistory then
                    for i = #history, historyIndex + 1, -1 do
                        table.remove(history, i)
                    end
                    table.insert(history, index)
                    historyIndex = #history
                end

                progressConn = game:GetService("RunService").RenderStepped:Connect(function()
                    if sound and sound.IsPlaying and sound.TimeLength > 0 then
                        local percent = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)
                        ProgressBar.Size = UDim2.new(percent, 0, 1, 0)
                        TimeLabel.Text = FormatTime(sound.TimePosition) .. " / " .. FormatTime(sound.TimeLength)
                        StatusLabel.Text = "▶ Reproduciendo"
                        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 130)
                    end
                end)

                sound.Ended:Connect(function()
                    if playAssetUrl ~= "" then
                        ToggleBtn.Image = playAssetUrl
                    end
                    if index < #playlist then
                        PlaySong(index + 1)
                    end
                end)
            else
                StatusLabel.Text = "❌ Error de audio"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            end
        end
    end)
end

RenderList = function(filterText)
