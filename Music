local function cleanup()
    if httpRequest then
        pcall(function()
            httpRequest({
                Url = DATABASE_URL .. "online_users/" .. sessionKey .. ".json",
                Method = "DELETE"
            })
        end)
    end
end

task.spawn(function()
    task.wait(1)
    while ScreenGui.Parent do
        pcall(function()
            local putUrl = DATABASE_URL .. "online_users/" .. sessionKey .. ".json"
            
            if httpRequest then
                httpRequest({
                    Url = putUrl,
                    Method = "PUT",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        time = os.time(), 
                        name = LocalPlayer.Name, 
                        userId = userId
                    })
                })
            end

            local getUrl = DATABASE_URL .. "online_users.json"
            local response = game:HttpGet(getUrl)
            if response and response ~= "null" then
                local data = HttpService:JSONDecode(response)
                local activeCount = 0
                local currentTime = os.time()

                if type(data) == "table" then
                    for key, info in pairs(data) do
                        if type(info) == "table" and info.time and (currentTime - info.time < 15) then
                            activeCount = activeCount + 1
                        else
                            if httpRequest then
                                httpRequest({
                                    Url = DATABASE_URL .. "online_users/" .. key .. ".json",
                                    Method = "DELETE"
                                })
                            end
                        end
                    end
                end

                OnlineLabel.Text = "Usuarios online: " .. tostring(math.max(1, activeCount))
            else
                OnlineLabel.Text = "Usuarios online: 1"
            end
        end)
        task.wait(5)
    end
    cleanup()
end)

ScreenGui.AncestryChanged:Connect(function()
    if not ScreenGui.Parent then
        cleanup()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if player == LocalPlayer then
        cleanup()
    end
end)

